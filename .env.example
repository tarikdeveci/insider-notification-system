# Copy to .env for local overrides. .env is gitignored. Never commit real values.
HTTP_ADDR=:8080
DATABASE_URL=postgres://notif:notif@postgres:5432/notif?sslmode=disable
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=info
PG_MAX_CONNS=10
REDIS_POOL_SIZE=10
# Used from CP2 on. Default points at the local mock provider.
# For the manual demo put your own webhook.site URL here (in .env only).
PROVIDER_URL=http://mock-provider:9090/

# Copy to .env for local overrides. .env is gitignored. Never commit real values.
HTTP_ADDR=:8080
# docker-compose.yml pins DATABASE_URL and REDIS_URL to its own containers and
# ignores these two; they only matter when you run the binaries yourself.
DATABASE_URL=postgres://notif:notif@postgres:5432/notif?sslmode=disable
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=info
PG_MAX_CONNS=10
REDIS_POOL_SIZE=10
# Used from CP2 on. Default points at the local mock provider.
# For the manual demo put your own webhook.site URL here (in .env only).
PROVIDER_URL=http://mock-provider:9090/
# Worker (defaults shown). max_attempts stays the column default 8.
WORKER_HTTP_ADDR=:8081
WORKER_CONCURRENCY_PER_CHANNEL=10
CLAIM_BATCH=20
RATELIMIT_MAX_WAIT=10s
RETRY_BASE_DELAY=2s
RETRY_MAX_DELAY=10m
MAX_DELIVERY_AGE=24h
SHUTDOWN_TIMEOUT=15s
REAPER_INTERVAL=5s
BREAKER_THRESHOLD=10
BREAKER_OPEN_FOR=30s
# Tracing is off unless set. `make up-tracing` sets it to http://jaeger:4318 for the compose stack.
# OTEL_EXPORTER_OTLP_ENDPOINT=
